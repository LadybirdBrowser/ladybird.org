---
import { releasesURL, repositoryURL } from "@/lib/downloads/config";

const buildInstructions =
  "https://github.com/LadybirdBrowser/ladybird/blob/master/Documentation/BuildInstructionsLadybird.md";
const repository = repositoryURL;
---

<section class="hero">
  <div class="hero__tf">
    <h1>Download Ladybird</h1>
    <p class="download-lead">
      Ladybird is in alpha. If you run into bugs or are missing a feature,
      report it from within Ladybird or <a href={`${repository}/issues`}
        >on GitHub</a
      >.
    </p>
  </div>
</section>

<div class="container downloads" data-downloads aria-busy="true">
  <p class="notice" data-platform-notice hidden></p>

  <!-- The page's shape while the manifest loads, so nothing jumps when the
       releases arrive. Screen readers hear the status line instead. -->
  <div class="downloads__loading" data-loading>
    <p class="visually-hidden" role="status">Loading releases…</p>
    <div aria-hidden="true">
      <div class="platform-bar">
        <!-- The switch itself, not yet usable. Its labels never change. -->
        <span class="platform-tabs platform-tabs--waiting"
          ><span class="tab">macOS</span><span class="tab">Linux</span></span
        >
        <span class="release-line"
          ><span class="tag">Alpha</span><span
            class="skeleton"
            style="width: 17.7em"></span></span
        >
      </div>
      <p class="tabpanel__intro">
        <span class="skeleton" style="width: 30em"></span>
      </p>
      <!-- The first card on either tab: a heading and an install button. -->
      <div class="panel method">
        <div class="method__head">
          <h3><span class="skeleton" style="width: 5em"></span></h3>
        </div>
        <div class="method__actions">
          <!-- A real button's box, so it has exactly its size. -->
          <span class="btn btn--primary skeleton-button"
            ><svg width="18" height="18"></svg>Download for macOS</span
          >
        </div>
      </div>
    </div>
  </div>
  <p class="downloads__empty" data-empty hidden>
    No releases have been published yet.
  </p>

  <div class="panel downloads__error" data-error hidden>
    <h2>Downloads couldn’t be loaded</h2>
    <p>
      Check your connection and reload the list. You can also <a
        href={buildInstructions}>build Ladybird from source</a
      >.
    </p>
    <button type="button" class="btn" data-retry>Reload</button>
  </div>

  <noscript>
    <style is:inline>
      [data-loading] {
        display: none !important;
      }
    </style>
    <div class="panel">
      <p>
        This page needs JavaScript to list the latest releases. You can read
        download links and checksums directly from the <a href={releasesURL}
          >release manifest</a
        >, or <a href={buildInstructions}>build Ladybird from source</a>.
      </p>
    </div>
  </noscript>

  <div data-content hidden>
    <section aria-labelledby="install-heading">
      <h2 id="install-heading" class="visually-hidden">Install Ladybird</h2>
      <div class="platform-bar">
        <div class="platform-tabs" role="tablist" aria-label="Operating system">
          <button
            type="button"
            role="tab"
            id="tab-macos"
            aria-controls="macos"
            aria-selected="true"
            data-platform="macOS">macOS</button
          ><button
            type="button"
            role="tab"
            id="tab-linux"
            aria-controls="linux"
            aria-selected="false"
            tabindex="-1"
            data-platform="Linux">Linux</button
          >
        </div>
        <p class="release-line">
          <span class="tag">Alpha</span>
          <span data-slot="release-version"></span>
          <span class="release-line__dot" aria-hidden="true">·</span>
          <time data-slot="release-date"></time>
        </p>
      </div>

      <div
        class="tabpanel"
        role="tabpanel"
        id="macos"
        aria-labelledby="tab-macos"
        tabindex="0"
      >
        <p class="tabpanel__intro" data-slot="mac-requirement"></p>

        <section class="panel method" aria-labelledby="dmg-heading">
          <div class="method__head">
            <h3 id="dmg-heading">Disk image</h3>
          </div>
          <div class="method__actions" data-slot="mac-actions"></div>
          <div class="method__verify" data-slot="mac-verify"></div>
          <ol class="steps">
            <li>Open the downloaded disk image.</li>
            <li>Drag Ladybird into your Applications folder.</li>
            <li>Open Ladybird from Applications.</li>
          </ol>
        </section>
      </div>

      <div
        class="tabpanel"
        role="tabpanel"
        id="linux"
        aria-labelledby="tab-linux"
        tabindex="0"
        hidden
      >
        <p class="tabpanel__intro">
          <span data-slot="linux-requirement"></span>
        </p>

        <section
          class="panel method"
          data-method="flatpak"
          aria-labelledby="flatpak-heading"
        >
          <div class="method__head">
            <h3 id="flatpak-heading">Flatpak</h3>
            <span class="tag">Recommended</span>
          </div>
          <p>Works on most distributions.</p>
          <div class="method__actions" data-slot="flatpak-action"></div>
          <div data-slot="flatpak-command"></div>
          <p class="method__foot" data-slot="flatpak-foot"></p>
          <div class="method__verify" data-slot="flatpak-verify"></div>
        </section>

        <section
          class="panel method"
          data-method="apt"
          aria-labelledby="apt-heading"
        >
          <div class="method__head">
            <h3 id="apt-heading">Ubuntu</h3>
          </div>
          <fieldset class="segmented" data-slot="apt-suites">
            <legend class="label">Ubuntu version</legend>
          </fieldset>
          <div data-slot="apt-command"></div>
          <p class="method__foot" data-slot="apt-foot"></p>
          <div class="method__verify" data-slot="apt-verify"></div>
        </section>

        <section
          class="panel method"
          data-method="rpm"
          aria-labelledby="rpm-heading"
        >
          <div class="method__head">
            <h3 id="rpm-heading">Fedora</h3>
          </div>
          <div data-slot="rpm-command"></div>
          <p class="method__foot" data-slot="rpm-foot"></p>
          <div class="method__verify" data-slot="rpm-verify"></div>
        </section>

        <section
          class="panel method"
          data-method="archive"
          aria-labelledby="archive-heading"
        >
          <div class="method__head">
            <h3 id="archive-heading">Standalone archive</h3>
          </div>
          <p>Doesn’t update automatically.</p>
          <ul class="files" data-slot="linux-files"></ul>
        </section>
      </div>
    </section>

    <section class="section" id="source" aria-labelledby="source-heading">
      <h2 id="source-heading" class="section-heading">Source code</h2>
      <p>
        Build this release yourself with the <a href={buildInstructions}
          >build instructions</a
        >.
      </p>
      <ul class="files" data-slot="source-files"></ul>
    </section>
  </div>

  <p class="toast" data-toast role="status" aria-live="polite"></p>

  <template data-template="file">
    <li class="file">
      <div class="file__info">
        <span class="file__label" data-field="label"></span>
        <span class="file__meta" data-field="meta"></span>
        <span class="file__verify" data-field="verify"></span>
      </div>
      <span class="file__actions" data-field="actions">
        <a class="btn btn--outline btn--small" data-field="link"
          ><svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M12 4v11m-5-5 5 5 5-5M5 20h14"></path></svg
          >Download</a
        >
      </span>
    </li>
  </template>

  <template data-template="third-party">
    <li class="file-group">
      <details>
        <summary>
          <span class="file__info">
            <span class="file__label">LGPL libraries</span>
            <span class="file__meta" data-field="count"></span>
          </span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
          >
        </summary>
        <p class="file-group__intro">
          This release uses these libraries under the GNU Lesser General Public
          License. Each archive holds the source code of a library, with our
          patches and build scripts.
        </p>
        <ul class="files" data-field="files"></ul>
      </details>
    </li>
  </template>

  <template data-template="command">
    <div class="command">
      <div class="command__bar">
        <span data-field="title"></span>
        <button type="button" class="copy" data-field="copy">Copy</button>
      </div>
      <pre tabindex="0"><code data-field="code" /></pre>
    </div>
  </template>

  <!-- Verification exists for the few who want it: one quiet toggle per
       file, with the details expanding underneath. -->
  <template data-template="verify-trigger">
    <button type="button" class="verify__trigger" data-field="trigger"
      >Verification<svg
        width="10"
        height="10"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
      ></button
    >
  </template>

  <template data-template="verify-file">
    <div class="verify__details" data-field="details">
      <span class="verify__file" data-field="file"></span>
      <ol class="verify__checks" data-field="checks"></ol>
    </div>
  </template>

  <!-- One check: what it checks, the command, and how to read its output. -->
  <template data-template="verify-check">
    <li class="verify__check">
      <span class="verify__head">
        <span class="verify__label" data-field="title"></span>
        <a class="verify__link" data-field="link" hidden></a>
      </span>
      <span class="verify__note" data-field="note" hidden></span>
      <span
        class="verify__value verify__value--command"
        data-field="command-row"
        hidden
      >
        <code data-field="command"></code>
        <button type="button" class="copy" data-field="command-copy"
          >Copy</button
        >
      </span>
      <span class="verify__outcome" data-field="outcome"></span>
      <span class="verify__value" data-field="expected" hidden>
        <code class="verify__hash" data-field="expected-text" tabindex="0"
        ></code>
        <button type="button" class="copy" data-field="expected-copy"
          >Copy</button
        >
      </span>
    </li>
  </template>
</div>

<script>
  import "@/lib/downloads/explorer";
</script>

<style>
  .download-lead {
    max-width: 560px;
    margin-top: 12px;
  }

  .downloads {
    padding-top: 40px;
  }

  .downloads[aria-busy="true"] {
    min-height: 50vh;
  }

  .downloads :global([hidden]) {
    display: none !important;
  }

  .label {
    display: block;
    margin: 0 0 8px;
    padding: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-emphasis);
    color: var(--text-muted);
  }

  /* ---- Notices, loading, and errors ---- */

  .notice {
    margin-bottom: 24px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }

  /* Shown only if loading takes a moment, so a quick load doesn't flash. */
  .downloads__loading {
    animation: skeleton-appear 0.3s 0.15s both;
  }

  @keyframes skeleton-appear {
    from {
      opacity: 0;
    }
  }

  .downloads__empty {
    color: var(--text-muted);
  }

  /* The button's box with its contents hidden: a tinted pill. */
  .skeleton-button {
    border-color: transparent;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: transparent;
    pointer-events: none;
  }

  .downloads__error h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-emphasis);
    margin-bottom: 8px;
  }

  .downloads__error p {
    margin-bottom: 20px;
  }

  /* ---- Platform switcher ---- */

  /* The switch, with the release it offers alongside. */
  .platform-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 24px;
  }

  .release-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .release-line [data-slot="release-version"] {
    color: var(--text-primary);
    font-weight: var(--weight-emphasis);
  }

  .platform-tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-subtle);
  }

  .platform-tabs [role="tab"],
  .platform-tabs .tab {
    min-width: 108px;
    padding: 8px 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-emphasis);
    text-align: center;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .platform-tabs [role="tab"]:hover {
    color: var(--text-primary);
  }

  .platform-tabs [aria-selected="true"] {
    border-color: var(--border);
    background: var(--bg-page);
    color: var(--text-primary);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }

  .tabpanel:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  .tabpanel__intro {
    margin-bottom: 20px;
  }

  /* ---- Cards ---- */

  /* Each method is a .panel. */
  .method + .method {
    margin-top: 16px;
  }

  .method p {
    margin-bottom: 16px;
  }

  .tag {
    padding: 1px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-emphasis);
    white-space: nowrap;
  }

  /* macOS */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 24px;
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--border-light);
    list-style: none;
    counter-reset: step;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  /* A fixed-size circle with a line-height equal to its height keeps the
     digit optically centered, regardless of the surrounding line height. */
  .steps li::before {
    content: counter(step);
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-primary);
    font-size: 13px;
    line-height: 22px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Linux */

  .method__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 8px;
  }

  /* A card's heading needs more room above a button, picker or command
     than above a line of text. */
  .method__head + :not(p) {
    margin-top: 16px;
  }

  .method__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-bottom: 24px;
  }

  /* The CPU note, if any, and the Verification toggle. */
  .method__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin: 16px 0 0 !important;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .segmented {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 12px;
    padding: 0;
    border: 0;
  }

  .segmented legend {
    float: left;
    margin: 0 8px 0 0;
  }

  .segmented :global(label) {
    position: relative;
    padding: 3px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .segmented :global(label:has(:checked)) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
  }

  .segmented :global(label:has(:focus-visible)) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .segmented :global(input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* ---- Commands ---- */

  .downloads :global(.command) {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    background: var(--bg-page);
  }

  .downloads :global(.command__bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 8px 6px 16px;
    border-bottom: 1px solid var(--border-light);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .downloads :global(.command pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  /* One command per line, after a prompt that isn't selected or copied.
     Wrapped lines are indented further than the command, like a shell
     continuation, so they don't look like a command of their own. */
  .downloads :global(.command__line) {
    display: block;
    padding-left: 4ch;
    text-indent: -4ch;
    white-space: normal;
  }

  .downloads :global(.command__line::before) {
    content: "$ ";
    color: var(--text-muted);
    user-select: none;
  }

  /* Each argument is a box of its own, and so is each piece of a path or URL
     between slashes. Lines break between boxes, and a box that fits on a line
     stays whole, never split at a hyphen. Only a box longer than a line wraps
     inside. */
  .downloads :global(.command__word),
  .downloads :global(.command__piece) {
    display: inline-block;
    max-width: 100%;
    text-indent: 0;
    overflow-wrap: anywhere;
  }

  .downloads :global(.command pre:focus-visible) {
    outline-offset: -2px;
  }

  .downloads :global(.copy) {
    padding: 2px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-page);
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .downloads :global(.copy:hover) {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .downloads :global(.copy[data-copied]) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ---- File lists ---- */

  .files {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .files :global(.file) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-light);
  }

  .files :global(.file__info) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .files :global(.file__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .files :global(.file__label) {
    font-weight: var(--weight-emphasis);
    color: var(--text-primary);
  }

  .files :global(.file__meta) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .files :global(.file-group) {
    border-bottom: 1px solid var(--border-light);
  }

  .files :global(.file-group summary) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 16px;
    padding: 16px 0;
    color: var(--text-muted);
    list-style: none;
    cursor: pointer;
  }

  .files :global(.file-group summary::-webkit-details-marker) {
    display: none;
  }

  .files :global(.file-group summary:hover),
  .files :global(.file-group details[open] summary) {
    color: var(--text-primary);
  }

  .files :global(.file-group summary svg) {
    transition: transform 0.15s;
  }

  .files :global(.file-group details[open] summary svg) {
    transform: rotate(180deg);
  }

  .files :global(.file-group__intro) {
    margin: 0 0 8px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* The archives sit inside the row, which draws the line below them. */
  .files :global(.file-group .files) {
    padding-left: 16px;
    border-top: 0;
  }

  .files :global(.file-group .file:last-child) {
    border-bottom: 0;
  }

  .downloads :global(.btn--small) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    font-size: var(--text-xs);
  }

  /* ---- Verification ---- */

  .files :global(.file__verify) {
    margin-top: 2px;
  }

  /* Present for the few who verify downloads, and quiet for everyone else. */
  .downloads :global(.verify__trigger) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .downloads :global(.verify__trigger:hover),
  .downloads :global(.verify__trigger[aria-expanded="true"]) {
    color: var(--text-primary);
  }

  .downloads :global(.verify__trigger svg) {
    transition: transform 0.15s;
  }

  .downloads :global(.verify__trigger[aria-expanded="true"] svg) {
    transform: rotate(180deg);
  }

  .downloads :global(.verify__details) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    background: var(--bg-page);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    line-height: 1.5;
    /* Sized by the space it is given, never by the checksum, so it can't
       widen a table column or a card. */
    contain: inline-size;
    transition:
      opacity 0.2s,
      translate 0.2s;
  }

  @starting-style {
    .downloads :global(.verify__details) {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  /* Under the macOS button, above the steps. */
  .method__verify :global(.verify__details) {
