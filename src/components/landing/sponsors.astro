---
import {
  currentSponsors,
  type SponsorTier,
} from "@/components/landing/sponsors";
import { logoWidth } from "@/components/landing/logo-size";

type Props = {
  sponsors?: SponsorTier[];
  heading?: string;
  id?: string;
  description?: string;
  previousSponsorsLink?: boolean;
};

const {
  sponsors = currentSponsors,
  heading = "Sponsors",
  id = "sponsors",
  description,
  previousSponsorsLink = false,
} = Astro.props;

const hasLogos = (tier: SponsorTier) => tier.sponsors.some((s) => s.logo);
---

<section id={id} class="section">
  <div class="container">
    <h2 class="section-heading">{heading}</h2>
    {description && <p class="sponsors-description">{description}</p>}

    {
      sponsors.map((tier) => (
        <div class="tier">
          <h4 class="tier-name">{tier.name}</h4>
          {hasLogos(tier) ? (
            <div class="tier-logos">
              {tier.sponsors.map((s) => {
                const logo = s.logo ? (
                  <>
                    <img
                      class:list={[{ "only-dark": s.logoLight }]}
                      style={`--logo-width: ${logoWidth(s.logo)}`}
                      src={s.logo}
                      alt={s.name}
                    />
                    {s.logoLight && (
                      <img
                        class="only-light"
                        style={`--logo-width: ${logoWidth(s.logoLight)}`}
                        src={s.logoLight}
                        alt={s.name}
                      />
                    )}
                  </>
                ) : (
                  <span class="card-name">{s.name}</span>
                );
                return (
                  <div class="logo-card">
                    {s.href ? (
                      <a href={s.href} rel="nofollow">
                        {logo}
                      </a>
                    ) : (
                      logo
                    )}
                  </div>
                );
              })}
            </div>
          ) : (
            <p class="tier-text">
              {tier.sponsors.map((s, i) => (
                <span class="tier-text-item">
                  {s.href ? (
                    <a href={s.href} rel="nofollow">
                      {s.name}
                    </a>
                  ) : (
                    s.name
                  )}
                  {i < tier.sponsors.length - 1 && (
                    <span aria-hidden="true">,</span>
                  )}
                </span>
              ))}
            </p>
          )}
        </div>
      ))
    }

    {
      previousSponsorsLink && (
        <p class="previous-sponsors-link">
          <a class="btn btn--outline" href="/previous-sponsors/">
            Previous sponsors
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .sponsors-description {
    margin-top: -12px;
    margin-bottom: 32px;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tier {
    margin-bottom: 32px;
  }

  .tier:last-child {
    margin-bottom: 0;
  }

  .tier-name {
    margin-bottom: 12px;
    color: var(--text-secondary);
    font-weight: var(--weight-emphasis);
    font-size: var(--text-sm);
  }

  .tier-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .logo-card {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 20px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    --logo-height: 26px;
  }

  .logo-card a {
    display: flex;
    align-items: center;
    max-width: 100%;
    text-decoration: none;
    color: var(--text-primary);
  }

  /* --logo-width is set per logo by logoWidth() so all logos get similar area. */
  .logo-card img {
    width: calc(var(--logo-height) * var(--logo-width));
    height: auto;
    max-width: 100%;
  }

  .card-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-emphasis);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .tier-text {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.35em;
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .tier-text-item {
    display: inline-flex;
  }

  .tier-text-item a {
    display: inline-flex;
  }

  .previous-sponsors-link {
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .tier-logos {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .logo-card {
      height: 56px;
      padding: 0 12px;
      min-width: 0;
      --logo-height: 21px;
    }

    .card-name {
      font-size: var(--text-xs);
      white-space: normal;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
